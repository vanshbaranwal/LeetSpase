// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model User {
  id                String        @id @default(uuid())
  name              String?
  username          String        @unique
  bio               String?
  preferredLanguage String?
  email             String        @unique
  image             String?
  role              UserRole      @default(USER)
  status            AccountStatus @default(ACTIVE)
  isVerified        Boolean       @default(false)
  lastActiveAt      DateTime      @default(now())
  password          String?
  googleId          String?       @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  problems          Problem[]
  submission        Submission[]
  problemSolved     ProblemSolved[]
  playlists         Playlist[]
  hostedSpases      CodingSpase[]            @relation("SpaseHost")
  createdSpases     CodingSpase[]            @relation("SpaseCreator")
  endedSpases       CodingSpase[]            @relation("SpaseEnder")
  spaseParticipants CodingSpaseParticipant[]
  spaseActivities   CodingSpaseActivity[]
  spaseJobs         CodingSpaseJob[]
  spaseMemberships  CodingSpaseMember[]
}

model Problem {
  id              String     @id @default(uuid())
  title           String
  titleKey        String     @unique
  description     String
  difficulty      Difficulty
  isDemo          Boolean    @default(false)
  tags            String[] // e.g.["tag1", "tag2", "tag3"]
  userId          String
  examples        Json
  constraints     String
  hints           String?
  intuition       String?
  editorial       String?
  walkthrough     String?
  timeComplexity  String?
  spaceComplexity String?
  youtubeUrl      String?

  testcases          Json
  codeSnippet        Json
  referenceSolutions Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relationship
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  submission        Submission[]
  solvedBy          ProblemSolved[]
  problemsPlaylists ProblemInPlaylist[]
  dailyChallenges   DailyChallenge[]
  activeSpases      CodingSpase[]
  spaseDocuments    CodingSpaseDocument[]
  spaseActivities   CodingSpaseActivity[]
}

model DailyChallenge {
  id            String   @id @default(uuid())
  challengeDate DateTime @unique @db.Date
  problemId     String
  createdAt     DateTime @default(now())

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId])
}

model Submission {
  id            String   @id @default(uuid())
  userId        String
  problemId     String
  sourceCode    Json
  language      String
  stdin         String?
  stdout        String?
  stderr        String?
  compileOutput String?
  status        String // accepted, wrong answer
  memory        String?
  time          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  testCases TestCaseResult[]
}

model TestCaseResult {
  id            String  @id @default(uuid())
  submissionId  String
  testCase      Int
  passed        Boolean
  stdout        String?
  expected      String
  stderr        String?
  compileOutput String?
  status        String
  memory        String?
  time          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model ProblemSolved {
  id        String @id @default(uuid())
  userId    String
  problemId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
}

model Playlist {
  id          String  @id @default(uuid())
  name        String
  description String?
  userId      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  problems ProblemInPlaylist[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([name, userId]) // unique playlist names per user
}

model ProblemInPlaylist {
  id         String @id @default(uuid())
  playListId String
  problemId  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  playList Playlist @relation(fields: [playListId], references: [id], onDelete: Cascade)
  problem  Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([playListId, problemId])
}

enum CodingSpaseGuestMode {
  EDITOR
  VIEWER
}

model CodingSpase {
  id               String               @id @default(uuid())
  code             String?              @unique @db.VarChar(5)
  hostId           String?
  creatorId        String?
  creatorKnown     Boolean              @default(true)
  endedById        String?
  historyStartedAt DateTime             @default(now())
  guestMode        CodingSpaseGuestMode
  problemId        String?
  language         String?
  revision         Int                  @default(0)
  createdAt        DateTime             @default(now())
  closedAt         DateTime?
  emptySince       DateTime?            @default(now())
  lastOccupiedAt   DateTime?
  closeReason      String?

  host         User?                    @relation("SpaseHost", fields: [hostId], references: [id], onDelete: SetNull)
  creator      User?                    @relation("SpaseCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  endedBy      User?                    @relation("SpaseEnder", fields: [endedById], references: [id], onDelete: SetNull)
  participants CodingSpaseParticipant[]
  visits       CodingSpaseVisit[]
  activities   CodingSpaseActivity[]
  problem      Problem?                 @relation(fields: [problemId], references: [id], onDelete: SetNull)
  members      CodingSpaseMember[]
  documents    CodingSpaseDocument[]
  jobs         CodingSpaseJob[]

  @@index([closedAt, emptySince])
  @@index([createdAt, id])
  @@index([hostId, createdAt])
  @@index([creatorId])
}

model CodingSpaseMember {
  spaseId       String
  userId        String
  sessionId     String?
  reservedUntil DateTime
  removedAt     DateTime?
  colorIndex    Int?

  spase CodingSpase @relation(fields: [spaseId], references: [id], onDelete: Cascade)
  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([spaseId, userId])
}

model CodingSpaseDocument {
  spaseId   String
  problemId String
  language  String
  state     Bytes

  spase   CodingSpase @relation(fields: [spaseId], references: [id], onDelete: Cascade)
  problem Problem     @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@id([spaseId, problemId, language])
}

enum CodingSpaseJobState {
  QUEUED
  RUNNING
  FINISHED
  FAILED
}

model CodingSpaseJob {
  id           String              @id @default(uuid())
  spaseId      String
  requestId    String
  userId       String?
  actorName    String
  problemId    String
  language     String
  mode         String
  sourceCode   String
  state        CodingSpaseJobState @default(QUEUED)
  result       Json?
  error        String?
  createdAt    DateTime            @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  problemTitle String?
  actor        User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  spase CodingSpase @relation(fields: [spaseId], references: [id], onDelete: Cascade)

  @@unique([spaseId, userId, requestId])
  @@index([spaseId, state, createdAt])
}

model CodingSpaseParticipant {
  id             String             @id @default(uuid())
  spaseId        String
  participantKey String
  userId         String?
  legacy         Boolean            @default(false)
  spase          CodingSpase        @relation(fields: [spaseId], references: [id], onDelete: Cascade)
  user           User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  visits         CodingSpaseVisit[]

  @@unique([spaseId, participantKey])
  @@index([userId])
}

model CodingSpaseVisit {
  id             String                 @id @default(uuid())
  spaseId        String
  participantId  String
  sessionId      String
  initialRole    String
  role           String
  joinedAt       DateTime               @default(now())
  lastSeenAt     DateTime               @default(now())
  disconnectedAt DateTime?
  leftAt         DateTime?
  leaveReason    String?
  spase          CodingSpase            @relation(fields: [spaseId], references: [id], onDelete: Cascade)
  participant    CodingSpaseParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([spaseId, joinedAt, id])
  @@index([participantId, sessionId, leftAt])
  @@index([leftAt, lastSeenAt])
}

model CodingSpaseActivity {
  id           String      @id @default(uuid())
  spaseId      String
  actorId      String?
  problemId    String?
  problemTitle String
  language     String
  type         String
  createdAt    DateTime    @default(now())
  spase        CodingSpase @relation(fields: [spaseId], references: [id], onDelete: Cascade)
  actor        User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  problem      Problem?    @relation(fields: [problemId], references: [id], onDelete: SetNull)

  @@index([spaseId, createdAt, id])
  @@index([actorId])
  @@index([problemId])
}
